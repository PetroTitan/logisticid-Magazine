# LogisticID Magazine environment configuration
#
# Placeholders only — never commit real values.

# Canonical public origin of the LogisticID website that serves this Magazine.
#
# This is the MAIN LogisticID host, not the Magazine's own infrastructure
# hostname. Every canonical URL, feed link, sitemap entry and Open Graph URL
# the Magazine emits is built from it, so pointing it at a *.vercel.app or
# *.netlify.app host would publish the infrastructure hostname as the public
# identity of the Magazine.
#
# Optional locally: falls back to http://localhost:3000.
# REQUIRED on a production deployment — the build fails without it rather than
# silently shipping localhost canonicals.
NEXT_PUBLIC_SITE_ORIGIN=https://logisticid.com
